{
  "name": "code-snippet-server",
  "version": "0.1.0",
  "description": "Serveur d'extraction AST live pour embarquer des snippets de code dans des pages HTML",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "ts-morph": "^24.0.0",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
